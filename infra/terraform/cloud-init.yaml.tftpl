#cloud-config
# First-boot host setup for the review VM (ticket #56's "Host setup" section).
# Idempotent-enough for a first-boot job; this is not re-run after initial
# provisioning, so it does not need to be idempotent against re-invocation.

package_update: true
package_upgrade: true

packages:
  - ca-certificates
  - curl
  - gnupg
  - unattended-upgrades

runcmd:
  # --- Docker Engine + Compose plugin, from Docker's own apt repo (Ubuntu's
  # default repos only ship the older docker.io / docker-compose v1) ---
  - install -m 0755 -d /etc/apt/keyrings
  - curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
  - chmod a+r /etc/apt/keyrings/docker.asc
  - >
    echo "deb [arch=$(dpkg --print-architecture)
    signed-by=/etc/apt/keyrings/docker.asc]
    https://download.docker.com/linux/ubuntu $(. /etc/os-release && echo $VERSION_CODENAME) stable" |
    tee /etc/apt/sources.list.d/docker.list > /dev/null
  - apt-get update
  - apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
  - usermod -aG docker ${admin_username}

  # --- Swap file, insurance against a Keycloak JVM spike ---
  - fallocate -l ${swap_size_mb}M /swapfile
  - chmod 600 /swapfile
  - mkswap /swapfile
  - swapon /swapfile
  - echo '/swapfile none swap sw 0 0' >> /etc/fstab

  # --- Automatic security updates ---
  - dpkg-reconfigure --frontend=noninteractive unattended-upgrades
  - systemctl enable --now unattended-upgrades
