  },
  "devDependencies": {
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.15.47",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
