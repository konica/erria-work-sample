DATABASE_URL=postgresql://erria:erria@localhost:5432/erria_dev
ANTHROPIC_API_KEY=sk-ant-your-key-here
CONSOLE_API_PORT=3000
WORKER_PORT=3100
WORKER_INTERNAL_URL=http://localhost:3100
CONSOLE_WEB_ORIGIN=http://localhost:5173

# Local dependencies (compose.yaml)
#
# DATABASE_URL above must agree with the credentials compose.yaml starts Postgres with.
# Both sides default to the same user, password and database name on port 5432, so the
# values above work with `pnpm compose:up` as-is. Nothing checks that the two agree.
#
# Docker Compose reads this file automatically, so defining POSTGRES_USER,
# POSTGRES_PASSWORD, POSTGRES_DB or POSTGRES_PORT here changes how the container is
# started. POSTGRES_PORT is the one you are most likely to need, if something already
# owns 5432 on your machine.
