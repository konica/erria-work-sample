DATABASE_URL=postgresql://erria:erria@localhost:5432/erria_dev
ANTHROPIC_API_KEY=sk-ant-your-key-here
CONSOLE_API_PORT=3000
WORKER_PORT=3100
WORKER_INTERNAL_URL=http://localhost:3100
CONSOLE_WEB_ORIGIN=http://localhost:5173

# Message dispatch mode: 'sandbox' (default) persists the message as sent and calls nothing
# external; 'graph' is a real Microsoft Graph send, declared but not implemented yet. This stays
# 'sandbox' here on purpose — the MVP deploys to a public URL (ADR-0007), and a stakeholder
# clicking "Approve & send" must never be able to email a real customer by accident. Absent,
# empty, or unrecognised values are rejected or fall back to 'sandbox', never to 'graph'.
MESSAGE_DISPATCH_MODE=sandbox

# Local dependencies (compose.yaml)
#
# DATABASE_URL above must agree with the credentials compose.yaml starts Postgres with.
# Both sides default to the same user, password and database name on port 5432, so the
# values above work with `pnpm compose:up` as-is. Nothing checks that the two agree.
#
# Docker Compose reads this file automatically, so defining POSTGRES_USER,
# POSTGRES_PASSWORD, POSTGRES_DB or POSTGRES_PORT here changes how the container is
# started. POSTGRES_PORT is the one you are most likely to need, if something already
# owns 5432 on your machine.

# Keycloak (compose.yaml) — local dev only, imports keycloak/realm-export.json (#75).
# KEYCLOAK_ADMIN_USER/PASSWORD are the bootstrap admin for the Keycloak admin console
# (http://localhost:8080), not an application credential. KEYCLOAK_SEED_PASSWORD is set on
# the seeded app users (e.g. minh.tran) by keycloak/dev-entrypoint.sh after import — kept out
# of realm-export.json itself so the committed realm carries no credential values. All three
# defaults below are throwaway dev values, not secrets, same as POSTGRES_PASSWORD above.
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_SEED_PASSWORD=erria-dev
