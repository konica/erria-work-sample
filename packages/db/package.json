{
  "name": "@erria/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./test-utils": {
      "types": "./dist/test-utils/testcontainers-postgres.d.ts",
      "default": "./dist/test-utils/testcontainers-postgres.js"
    }
  },
  "scripts": {
    "postinstall": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "seed": "tsx src/seed/seed.ts",
    "import:triggers": "tsx src/seed/import-triggers.ts"
  },
  "dependencies": {
    "@prisma/client": "^7.0.0",
    "@prisma/adapter-pg": "^7.0.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "prisma": "^7.0.0",
    "@types/pg": "^8.11.0",
    "@types/node": "^24.0.0",
    "@testcontainers/postgresql": "^11.0.0",
    "vitest": "^3.0.0",
    "typescript": "^5.7.0",
    "dotenv": "^16.4.0",
    "tsx": "^4.19.0"
  }
}
