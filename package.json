{
  "name": "erria-outreach-agent",
  "private": true,
  "engines": { "node": ">=24" },
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "bootstrap": "node scripts/setup.mjs",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "test:setup": "node --test scripts/setup.test.mjs",
    "compose:up": "docker compose up -d --wait && pnpm --filter @erria/db exec prisma migrate deploy",
    "compose:down": "docker compose down",
    "compose:reset": "docker compose down -v && pnpm compose:up"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "eslint": "^9.17.0",
    "typescript-eslint": "^8.19.0",
    "@typescript-eslint/eslint-plugin": "^8.19.0",
    "@typescript-eslint/parser": "^8.19.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "cpu-features",
      "esbuild",
      "prisma",
      "protobufjs",
      "ssh2"
    ]
  }
}
