# Deployment overlay secrets — compose.deploy.yaml (ADR-0007, issue #57).
#
# This file documents every variable the overlay reads; it is not itself a secret and is safe
# to commit (see .gitguardian.yaml). The real file lives ONLY on the VM as `.env` in the repo
# checkout (e.g. /opt/erria/.env), mode 600, never committed, with its contents also recorded
# in the team's password manager — same convention the deployment design doc's §7 describes.
# Every CHANGE_ME below must be replaced with a real, unique, generated value before `up -d`.
#
# Copy it into place with: cp .env.deploy.example .env

# --- Postgres (compose.yaml's service, inherited by this overlay) ---
# Deploy overrides the dev defaults (erria/erria) with real values — this server is reachable
# from other containers on a public-facing box even though it is not published to the internet.
POSTGRES_USER=erria
POSTGRES_PASSWORD=CHANGE_ME_generate_a_strong_password
POSTGRES_DB=erria

# Second role/database on this SAME Postgres server, for Keycloak (issue #57: "a separate
# database on the same server, not a separate server"). Created once by
# deploy/postgres-init/001-create-keycloak-db.sh on first boot of a fresh volume.
KEYCLOAK_DB_PASSWORD=CHANGE_ME_generate_a_strong_password

# --- Public hostname and TLS (issue #56 provisions the DNS record this must match) ---
DEPLOY_DOMAIN=outreach.erria.example
LETSENCRYPT_EMAIL=ops@erria.example

# --- Keycloak bootstrap admin ---
# For the admin console, reachable only via an SSH tunnel to the VM's loopback interface and
# blocked at Caddy for everyone else (compose.deploy.yaml, deploy/Caddyfile, issue #59).
# Generate a strong, unique value; do not reuse the dev convenience default (admin/admin from
# .env.example). This is a *bootstrap* account, not a standing one: deploy/README.md's "Removing
# the bootstrap admin" step deletes it once real, named admin accounts exist in the realm — this
# password should stop being valid shortly after first use.
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_generate_a_strong_password

# --- App images (issue #58 publishes these to GHCR tagged with the commit SHA) ---
# No default in compose.deploy.yaml on purpose — an unset value fails the pull loudly rather
# than silently resolving to a `latest` tag that was never pushed.
DEPLOY_IMAGE_TAG=CHANGE_ME_commit_sha_to_deploy

# --- Nightly backups (issue #60; deploy/scripts/backup-postgres.sh, deploy/crontab) ---
# The storage account and container infra/terraform/storage.tf creates — `terraform output
# backup_storage_account_name` / `backup_container_name`. Not a secret and not derivable from the
# VM's own metadata, which is why it lives here: authentication is the VM's managed identity, so
# there is no key or SAS token to put in this file at all.
BACKUP_STORAGE_ACCOUNT=erriareviewbackups
BACKUP_CONTAINER=pg-backups
# Dumps older than this are deleted by the nightly run. 14 days is two weeks of nightly dumps of a
# review-phase database (~40 KB each seeded, so pennies of storage) — long enough that a problem
# noticed on returning from a week away is still recoverable, and short enough that the container
# does not accumulate indefinitely. Raise it before real buyer correspondence exists, alongside
# ADR-0007's revisit trigger.
BACKUP_RETENTION_DAYS=14

# --- Application variables (see .env.example for the full description of each) ---
# Repeated here rather than shared with a developer's .env.example: the VM is a separate
# machine with its own .env, and DATABASE_URL below is built inside compose.deploy.yaml from
# the POSTGRES_* values above rather than repeated as a second literal that could disagree.
ANTHROPIC_API_KEY=CHANGE_ME_real_anthropic_api_key
# sandbox (default) persists a Message as sent and calls nothing external; graph is a real
# Microsoft Graph send (issue #63) and must only ever be turned on deliberately, per ADR-0007 —
# a public review URL must never let a stakeholder's click email a real customer by accident.
MESSAGE_DISPATCH_MODE=sandbox
# Left unset: console-api serves the built console-web SPA itself on this same origin
# (ADR-0007), so there is no separate origin for CORS to open here.
CONSOLE_WEB_ORIGIN=
