{
  "realm": "erria",
  "enabled": true,
  "displayName": "Erria Outreach Agent",
  "displayNameHtml": "Erria Outreach Agent",
  "loginTheme": "erria",
  "sslRequired": "external",
  "registrationAllowed": false,
  "editUsernameAllowed": false,
  "resetPasswordAllowed": true,
  "bruteForceProtected": true,
  "roles": {
    "realm": [
      {
        "name": "reviewer",
        "description": "Can review the queue, approve/reject/edit drafts, and resolve escalations."
      },
      {
        "name": "admin",
        "description": "Superset of reviewer, plus access to the Settings screen (#79).",
        "composite": true,
        "composites": {
          "realm": ["reviewer"]
        }
      }
    ]
  },
  "clients": [
    {
      "clientId": "console-web",
      "name": "Console (SPA)",
      "description": "React console. Public client, Authorization Code + PKCE — no client secret, matching a browser's inability to keep one.",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:5173/*", "http://127.0.0.1:5173/*"],
      "webOrigins": ["http://localhost:5173", "http://127.0.0.1:5173"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*##http://127.0.0.1:5173/*"
      }
    },
    {
      "clientId": "console-api",
      "name": "Console API (resource server)",
      "description": "NestJS API. Bearer-only — it validates access tokens issued to console-web against this realm's JWKS (#77); it never initiates its own login flow.",
      "protocol": "openid-connect",
      "enabled": true,
      "bearerOnly": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    }
  ],
  "users": [
    {
      "username": "minh.tran",
      "enabled": true,
      "firstName": "Minh",
      "lastName": "Tran",
      "email": "minh.tran@erria.example",
      "emailVerified": true,
      "requiredActions": [],
      "realmRoles": ["reviewer"]
    },
    {
      "username": "huy.dinh",
      "enabled": true,
      "firstName": "Huy",
      "lastName": "Dinh",
      "email": "huy.dinh@erria.example",
      "emailVerified": true,
      "requiredActions": [],
      "realmRoles": ["admin"]
    }
  ]
}
